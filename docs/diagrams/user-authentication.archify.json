    { "id": "cognito", "type": "external", "label": "Amazon Cognito", "sublabel": "Managed Login" },
    { "id": "jwks", "type": "external", "label": "Cognito JWKS", "sublabel": "issuer-bound keys" },
    { "id": "profile", "type": "external", "label": "UserInfo", "sublabel": "verified profile" },

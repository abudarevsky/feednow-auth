# Copy to .env for the local Cognito journey. Do not commit .env.
FEEDNOW_SQLITE_PATH=/data/feednow-auth.db
FEEDNOW_COGNITO_ISSUER=https://cognito-idp.eu-north-1.amazonaws.com/eu-north-1_example
FEEDNOW_COGNITO_CLIENT_ID=replace-with-public-client-id
FEEDNOW_COGNITO_DOMAIN=https://feednow-auth-dev.auth.eu-north-1.amazoncognito.com
# For browser SSO in local development, Cognito must allow this callback. The
# UI's /api proxy forwards it to the FeedNow API and sets the localhost cookie.
FEEDNOW_COGNITO_REDIRECT_URI=http://localhost:3000/api/oauth/callback
FEEDNOW_FRONTEND_URL=http://localhost:3000
FEEDNOW_COGNITO_LOGOUT_URI=http://localhost:8000/logout
FEEDNOW_SESSION_TTL_SECONDS=28800
# Required for first-login provisioning (verified profile email):
# <FEEDNOW_COGNITO_DOMAIN>/oauth2/userInfo
FEEDNOW_COGNITO_USERINFO_URL=https://feednow-auth-dev.auth.eu-north-1.amazoncognito.com/oauth2/userInfo
# Generate locally: openssl rand -base64 32
FEEDNOW_PEPPER_SECRET=replace-with-base64-32-byte-secret
# Local-only bearer credential for a registered product service. Use a random
# value and never commit the real value in .env.
FEEDNOW_VISPECTOR_SERVICE_SECRET=replace-with-random-local-service-secret
# Optional registration used for the browser authorization-code handoff.
FEEDNOW_VISPECTOR_URL=http://localhost:5173
FEEDNOW_VISPECTOR_CALLBACK_PATH=/auth/callback

# Copy to .env.<environment>.secrets and chmod 600.
# This file is loaded as process environment by CDK and deploy/aws/deploy.sh.
# The shared service secret is passed to Lambda as an environment variable.
# FEEDNOW_VISPECTOR_SERVICE_SECRET=

# Legacy encrypted service credential setting, for existing deployments only.
# FEEDNOW_VISPECTOR_SERVICE_CREDENTIAL_CIPHERTEXT_B64=

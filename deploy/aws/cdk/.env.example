# Copy this file to deploy/aws/cdk/.env.dev, .env.staging, or .env.prod
# (never committed). `--env` selects exactly one file. AWS credentials and
# AWS_PROFILE belong in the standard AWS CLI configuration, never here.
# This file contains deployment configuration and may contain a service secret.
# Keep it ignored and owner-only (chmod 600); never commit it.

# Target environment: dev | staging | prod
FEEDNOW_ENV=dev

# AWS account id expected for this FeedNow environment (12 digits).
AWS_ACCOUNT_ID=123456789012

# Deployment region
AWS_REGION=eu-north-1

# Browser account UI origin. Production is https://account.feednow.io; dev may
# use http://localhost:3000 only when importing the existing dev Cognito pool.
ACCOUNT_BASE_URL=https://account.example.invalid

# Required for every environment. Cognito is provisioned and configured by the
# operator; the CDK stack imports it and never creates or replaces it.
# FEEDNOW_COGNITO_USER_POOL_ID=eu-north-1_...
# FEEDNOW_COGNITO_CLIENT_ID=...
# FEEDNOW_COGNITO_CALLBACK_URLS=http://localhost:3000/api/oauth/callback,http://localhost:8000/oauth/cli-callback
# Optional when the existing pool's Cognito domain does not use the default
# feednow-auth-<environment> prefix. Set its HTTPS origin without a path.
# FEEDNOW_COGNITO_DOMAIN=https://<actual-prefix>.auth.<region>.amazoncognito.com
# Optional service link in the account UI.
# VISPECTOR_BASE_URL=https://vispector.example.invalid

# Required only when deploying the custom domain UI.
# ACCOUNT_DOMAIN_NAME=account.feednow.io
# ACM_CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/...
# ROUTE53_HOSTED_ZONE_ID=Z1234567890

# Cognito is user-provisioned; set the existing pool and public client IDs.
# API endpoints are read from CloudFormation outputs.
# The operator stores only KMS ciphertext for the Cognito client secret and
# API-key pepper here. Never enter their plaintext values.
# FEEDNOW_COGNITO_CLIENT_SECRET_CIPHERTEXT_B64=
# FEEDNOW_PEPPER_CIPHERTEXT_B64=
# The plaintext shared-service secret belongs in the matching
# .env.<environment>.secrets file. See .env.secrets.example.

# Optional service link shown on the account page. Leave unset until Vispector is deployed.
# FEEDNOW_VISPECTOR_URL=https://app.example.invalid
# Optional registered-service callback and policy overrides.
# FEEDNOW_VISPECTOR_CALLBACK_PATH=/auth/callback
# FEEDNOW_VISPECTOR_ENABLED=true
# FEEDNOW_VISPECTOR_PERMISSIONS=projects:read,projects:write,inspect

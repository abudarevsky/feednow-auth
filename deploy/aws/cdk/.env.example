# Copy this file to deploy/aws/cdk/.env (never committed) or export the same
# names in the shell. Shell values take precedence over the .env file.
# Non-secret deployment inputs only: no account ids, no secret material.

# Target environment: dev | staging | prod
FEEDNOW_ENV=dev

# AWS account id to deploy into (12 digits, e.g. from `aws sts get-caller-identity`)
CDK_DEFAULT_ACCOUNT=<your-aws-account-id>

# Deployment region
AWS_REGION=<your-deployment-region>

# Comma-separated HTTPS OAuth redirect URIs for the Cognito app client
# (callback and logout). Required at synth time: CDK validates OAuth redirect
# URIs, so the stack refuses to synthesize when this is empty.
COGNITO_CALLBACK_URLS=https://app.example.invalid/oauth/callback
